/* ===== Home hero background ===== */
.page-home .page-shell {
  background: var(--navy-deep) url("../assets/background/background.jpeg") center center / cover no-repeat fixed;
}

.page-home .page-shell::before {
  content: "";
  position: fixed;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(3, 16, 29, 0.55) 0%, rgba(3, 16, 29, 0.72) 45%, rgba(3, 16, 29, 0.88) 100%),
    radial-gradient(ellipse 100% 60% at 50% 100%, rgba(6, 24, 43, 0.5) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.page-home .site-header,
.page-home .ornament-divider,
.page-home .home-main,
.page-home .home-footer {
  position: relative;
  z-index: 1;
}

.home-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0.5rem 1.25rem 1rem;
  max-width: var(--page-max);
  margin: 0 auto;
  width: 100%;
}

.home-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.5rem 0 2rem;
  min-height: 42vh;
}

.home-title {
  font-size: clamp(2.35rem, 9vw, 3.25rem);
  letter-spacing: 0.04em;
  margin: 0 0 1.25rem;
  background: linear-gradient(180deg, var(--gold-light) 0%, var(--gold) 45%, #c49a4a 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: none;
  filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
}

.home-title span {
  display: block;
}

.home-subtitle {
  font-family: var(--font-serif);
  font-size: clamp(0.95rem, 3.8vw, 1.1rem);
  color: var(--ivory);
  max-width: 18rem;
  margin: 0 0 2rem;
  line-height: 1.65;
  opacity: 0.95;
}

.home-cta {
  min-width: min(100%, 16rem);
  font-size: 1rem;
  padding: 1rem 2.25rem;
}

.home-cta .btn-arrow {
  margin-left: 0.15rem;
  font-weight: 700;
}

.home-footer {
  text-align: center;
  padding: 0 1.25rem 1.75rem;
  max-width: var(--page-max);
  margin: 0 auto;
  width: 100%;
}

.home-meta {
  font-size: 0.62rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ivory);
  opacity: 0.85;
  margin: 0.75rem 0 1rem;
  line-height: 1.6;
}

.home-scroll-hint {
  color: var(--gold);
  font-size: 1.25rem;
  opacity: 0.7;
  animation: bounce-hint 2.5s ease-in-out infinite;
}

@keyframes bounce-hint {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(4px);
  }
}

@media (min-width: 768px) {
  .home-hero {
    min-height: 48vh;
  }
}
