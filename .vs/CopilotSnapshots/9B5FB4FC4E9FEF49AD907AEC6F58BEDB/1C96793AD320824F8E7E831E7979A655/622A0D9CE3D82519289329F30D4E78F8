.about-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.about-title {
  font-size: clamp(1.75rem, 6vw, 2.25rem);
  text-align: center;
  margin: 0;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.about-lead {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  text-align: center;
  color: var(--ivory);
  margin: 0;
  line-height: 1.55;
}

.about-card {
  border-radius: 1rem;
  border: var(--border-gold);
  background: rgba(6, 24, 43, 0.7);
  padding: 1.25rem 1.1rem;
}

.about-card h2 {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  color: var(--gold-light);
  margin: 0 0 0.65rem;
  letter-spacing: 0.04em;
}

.about-card p {
  margin: 0 0 0.85rem;
  font-size: 0.875rem;
  color: var(--muted);
  line-height: 1.65;
}

.about-card p:last-child {
  margin-bottom: 0;
}

.about-list {
  margin: 0;
  padding-left: 1.1rem;
  color: var(--muted);
  font-size: 0.875rem;
  line-height: 1.7;
}

.about-list li {
  margin-bottom: 0.35rem;
}

.about-cta-wrap {
  text-align: center;
  padding-top: 0.5rem;
}

.about-cta {
  min-width: min(100%, 14rem);
}
