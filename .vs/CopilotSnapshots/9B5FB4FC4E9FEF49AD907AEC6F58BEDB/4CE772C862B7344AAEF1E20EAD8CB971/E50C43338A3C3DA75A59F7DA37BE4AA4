.result-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  padding-bottom: 0.5rem;
}

.result-intro {
  text-align: center;
}

.result-label {
  font-family: var(--font-serif);
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold);
  margin: 0 0 0.35rem;
}

.result-name {
  font-size: clamp(2rem, 8vw, 2.75rem);
  margin: 0 0 0.25rem;
  letter-spacing: 0.02em;
}

.result-source {
  font-size: 0.65rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0 0 1rem;
}

.result-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  align-items: start;
}

.result-photo-wrap {
  border-radius: var(--radius-photo);
  overflow: hidden;
  aspect-ratio: 3 / 4;
  border: var(--border-gold);
  box-shadow: var(--shadow-soft);
}

.result-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}

.result-side {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  min-width: 0;
}

.result-quote {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 0.8rem;
  line-height: 1.45;
  color: var(--ivory);
  margin: 0;
  opacity: 0.95;
}

.result-traits {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.result-trait {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.58rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0.45rem 0.55rem;
  border-radius: var(--radius-pill);
  border: var(--border-gold);
  background: rgba(6, 24, 43, 0.85);
  color: var(--ivory);
}

.trait-icon {
  width: 1.1rem;
  text-align: center;
  color: var(--gold);
  flex-shrink: 0;
}

.result-card {
  border-radius: 1rem;
  border: 1px solid rgba(11, 36, 60, 0.9);
  background: rgba(6, 24, 43, 0.65);
  padding: 1.1rem 1rem;
  box-shadow: inset 0 1px 0 rgba(214, 173, 96, 0.08);
}

.result-section {
  margin-bottom: 1.1rem;
}

.result-section:last-child {
  margin-bottom: 0;
}

.result-section-head {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.55rem;
}

.result-section-icon {
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  border: var(--border-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  color: var(--gold);
  flex-shrink: 0;
}

.result-section-title {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  margin: 0;
  color: var(--ivory);
}

.result-section p {
  margin: 0;
  font-size: 0.8125rem;
  color: var(--muted);
  line-height: 1.6;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.result-actions .btn-outline {
  width: 100%;
}

.result-discover {
  text-align: center;
  padding-top: 0.5rem;
}

.result-discover-text {
  font-size: 0.58rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0.5rem 0 0.35rem;
}

.result-discover-arrow {
  color: var(--gold);
  font-size: 1rem;
  opacity: 0.75;
}

@media (min-width: 768px) {
  .result-hero {
    gap: 1rem;
  }

  .result-quote {
    font-size: 0.875rem;
  }
}
