/* ===== Design tokens ===== */
:root {
  --navy: #06182b;
  --navy-deep: #03101d;
  --navy-soft: #0b243c;
  --ivory: #f6f0df;
  --gold: #d6ad60;
  --gold-light: #ead39a;
  --text: #f7f3e8;
  --muted: #b9c0c8;

  --font-serif: "Cormorant Garamond", "Playfair Display", Georgia, serif;
  --font-sans: "Inter", "Montserrat", system-ui, sans-serif;

  --header-h: 4.5rem;
  --page-max: 28rem;
  --radius-pill: 999px;
  --radius-card: 0.65rem;
  --radius-photo: 1.25rem;
  --border-gold: 1px solid rgba(214, 173, 96, 0.85);
  --shadow-soft: 0 8px 32px rgba(0, 0, 0, 0.45);
  --transition: 0.2s ease;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  min-height: 100dvh;
  font-family: var(--font-sans);
  font-size: 0.9375rem;
  line-height: 1.55;
  color: var(--text);
  background-color: var(--navy-deep);
  overflow-x: hidden;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
  cursor: pointer;
  border: none;
  background: none;
  color: inherit;
}

button:focus-visible,
a:focus-visible {
  outline: 2px solid var(--gold-light);
  outline-offset: 3px;
}

.page-shell {
  position: relative;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
}

.page-inner {
  width: 100%;
  max-width: var(--page-max);
  margin: 0 auto;
  padding: 0 1.25rem 2rem;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* ===== Pattern background (quiz, result, about) ===== */
body.has-pattern {
  background-color: var(--navy-deep);
  background-image:
    radial-gradient(ellipse 120% 80% at 50% 0%, rgba(11, 36, 60, 0.9) 0%, transparent 55%),
    radial-gradient(circle at 20% 30%, rgba(214, 173, 96, 0.04) 0%, transparent 40%),
    radial-gradient(circle at 80% 70%, rgba(214, 173, 96, 0.03) 0%, transparent 35%),
    repeating-linear-gradient(
      45deg,
      transparent,
      transparent 12px,
      rgba(214, 173, 96, 0.015) 12px,
      rgba(214, 173, 96, 0.015) 13px
    ),
    repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 12px,
      rgba(255, 255, 255, 0.012) 12px,
      rgba(255, 255, 255, 0.012) 13px
    );
  background-attachment: fixed;
}

/* ===== Header ===== */
.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 1rem 1.25rem 0.75rem;
  max-width: var(--page-max);
  margin: 0 auto;
  width: 100%;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  min-width: 0;
}

.brand-logo {
  width: 2.75rem;
  height: 2.75rem;
  flex-shrink: 0;
  object-fit: contain;
  border-radius: 50%;
}

.brand-text {
  display: flex;
  flex-direction: column;
  font-family: var(--font-serif);
  font-size: 0.55rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  line-height: 1.35;
  color: var(--ivory);
  text-transform: uppercase;
}

.menu-toggle {
  flex-shrink: 0;
  width: 2.25rem;
  height: 2.25rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 0;
}

.menu-toggle span {
  display: block;
  width: 1.35rem;
  height: 2px;
  background: var(--gold);
  border-radius: 1px;
  transition: transform var(--transition), opacity var(--transition);
}

.menu-toggle[aria-expanded="true"] span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.menu-toggle[aria-expanded="true"] span:nth-child(2) {
  opacity: 0;
}

.menu-toggle[aria-expanded="true"] span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

/* ===== Nav overlay ===== */
.site-nav {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(3, 16, 29, 0.92);
  backdrop-filter: blur(8px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  padding: 2rem;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition), visibility var(--transition);
}

.site-nav.is-open {
  opacity: 1;
  visibility: visible;
}

.site-nav a {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ivory);
  padding: 0.35rem 0.75rem;
  border-bottom: 1px solid transparent;
  transition: border-color var(--transition), color var(--transition);
}

.site-nav a:hover,
.site-nav a[aria-current="page"] {
  color: var(--gold-light);
  border-bottom-color: var(--gold);
}

/* ===== Ornament divider ===== */
.ornament-divider {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  max-width: var(--page-max);
  margin: 0 auto 1.25rem;
  padding: 0 1.25rem;
  width: 100%;
}

.ornament-divider::before,
.ornament-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold) 20%, var(--gold) 80%, transparent);
  opacity: 0.75;
}

.ornament-divider .ornament-gem {
  width: 0.5rem;
  height: 0.5rem;
  background: var(--gold);
  transform: rotate(45deg);
  flex-shrink: 0;
  opacity: 0.9;
}

.ornament-divider--tight {
  margin-bottom: 0.85rem;
}

/* ===== Buttons ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  font-family: var(--font-serif);
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border-radius: var(--radius-pill);
  padding: 0.85rem 1.75rem;
  min-height: 2.75rem;
  transition:
    background var(--transition),
    color var(--transition),
    border-color var(--transition),
    box-shadow var(--transition),
    transform 0.15s ease;
}

.btn-primary {
  background: linear-gradient(180deg, var(--gold-light) 0%, var(--gold) 100%);
  color: var(--navy-deep);
  box-shadow:
    0 4px 20px rgba(214, 173, 96, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.35);
}

.btn-primary:hover {
  box-shadow:
    0 6px 28px rgba(214, 173, 96, 0.45),
    inset 0 1px 0 rgba(255, 255, 255, 0.4);
  transform: translateY(-1px);
}

.btn-primary:active {
  transform: translateY(0);
  box-shadow: 0 2px 12px rgba(214, 173, 96, 0.3);
}

.btn-outline {
  background: transparent;
  color: var(--ivory);
  border: var(--border-gold);
}

.btn-outline:hover {
  background: rgba(214, 173, 96, 0.08);
  border-color: var(--gold-light);
}

.btn-block {
  width: 100%;
}

.btn-icon {
  font-size: 1.1em;
  line-height: 1;
}

/* ===== Typography helpers ===== */
.serif-title {
  font-family: var(--font-serif);
  font-weight: 600;
  color: var(--ivory);
  line-height: 1.15;
}

.text-muted {
  color: var(--muted);
}

/* ===== Responsive ===== */
@media (min-width: 768px) {
  :root {
    --page-max: 32rem;
  }

  .brand-text {
    font-size: 0.6rem;
  }

  .brand-logo {
    width: 3rem;
    height: 3rem;
  }
}

@media (min-width: 1024px) {
  :root {
    --page-max: 36rem;
  }
}
